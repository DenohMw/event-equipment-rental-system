# Password reset SMS delivery (Africa's Talking)
# Configure an Africa's Talking API key, username, and optional approved sender ID.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
# Use "sandbox" for the Africa's Talking sandbox; leave blank for live SMS.
AT_ENV=sandbox
APP_URL=http://localhost:3000
# For local development only: print reset codes in the backend console when SMS is not configured.
PASSWORD_RESET_DEV_MODE=false
